# Copy to .env for docker-compose. Dummy values only: never commit real secrets.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-db
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional first-admin bootstrap (password >= 12 chars). Leave empty to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Dev-only demo data: used with SPRING_PROFILES_ACTIVE=dev
DEMO_PASSWORD=
